{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notelet",
  "version": "0.15.12",
  "identifier": "app.koenote.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Notelet",
        "width": 1060,
        "height": 620,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true
      },
      {
        "label": "recording-overlay",
        "url": "index.html#recording-overlay",
        "title": "Notelet 録音中",
        "width": 276,
        "height": 52,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "meeting-notify",
        "url": "index.html#meeting-notify",
        "title": "Notelet 会議を検出",
        "width": 340,
        "height": 84,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.openai.com https://api.anthropic.com https://generativelanguage.googleapis.com https://speech.googleapis.com https://api.deepgram.com https://api.groq.com https://api.stepfun.ai https://api.stepfun.com https://api.notion.com https://hooks.slack.com http://localhost:11434; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
